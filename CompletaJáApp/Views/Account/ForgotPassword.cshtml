@{
    ViewData["Title"] = "Recuperar Senha - CompletaJá";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Reaproveitamos o mesmo CSS da tela de login -->
    <link rel="stylesheet" href="~/css/login.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <div class="app-container">
        
        <div class="header">
            <div class="logo-icon">
                <i class="fa-solid fa-key"></i>
            </div>
            <h1>Recuperar Senha</h1>
            <p>Informe seu e-mail para receber as instruções</p>
        </div>

        <div class="form-container">
            
            <!-- Mostra erro se o campo vier vazio -->
            @if (ViewBag.Erro != null)
            {
                <div style="color: #DC2626; text-align: center; font-size: 14px; margin-bottom: 15px;">
                    <i class="fa-solid fa-circle-exclamation"></i> @ViewBag.Erro
                </div>
            }

            <!-- Mostra a mensagem de sucesso se der tudo certo -->
            @if (ViewBag.Sucesso != null)
            {
                <div style="color: #16A34A; text-align: center; font-size: 14px; margin-bottom: 20px; line-height: 1.5;">
                    <i class="fa-solid fa-circle-check" style="font-size: 30px; margin-bottom: 10px;"></i> <br />
                    @ViewBag.Sucesso
                </div>
                
                <a asp-action="Index" class="btn-submit" style="text-decoration: none; background-color: #16A34A;">
                    Voltar ao Login
                </a>
            }
            else
            {
                <!-- Formulário que só aparece se não tiver mensagem de sucesso -->
                <form asp-action="ForgotPassword" method="post">
                    <div class="input-group">
                        <label>E-mail Cadastrado</label>
                        <div class="input-field">
                            <i class="fa-regular fa-envelope"></i>
                            <input type="email" name="Email" placeholder="seu@email.com" required />
                        </div>
                    </div>

                    <button type="submit" class="btn-submit">
                        Enviar Link <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>
            }
        </div>

        <div class="footer">
            <a asp-action="Index" style="text-decoration: none; color: #6B7280;">
                <i class="fa-solid fa-arrow-left"></i> Voltar para o Login
            </a>
        </div>

    </div>
</body>
</html>