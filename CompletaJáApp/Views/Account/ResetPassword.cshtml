@{
    ViewData["Title"] = "Nova Senha - CompletaJá";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Reaproveitamos o mesmo CSS da tela de login -->
    <link rel="stylesheet" href="~/css/login.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <div class="app-container">
        
        <div class="header">
            <div class="logo-icon">
                <i class="fa-solid fa-lock"></i>
            </div>
            <h1>Nova Senha</h1>
            <p>Escolha uma nova senha para a sua conta</p>
        </div>

        <div class="form-container">
            
            <!-- Mostra erro se o campo vier vazio -->
            @if (ViewBag.Erro != null)
            {
                <div style="color: #DC2626; text-align: center; font-size: 14px; margin-bottom: 15px;">
                    <i class="fa-solid fa-circle-exclamation"></i> @ViewBag.Erro
                </div>
            }

            @if (ViewBag.TokenInvalido == true)
            {
                <div style="color: #DC2626; text-align: center; font-size: 14px; margin-bottom: 20px; line-height: 1.5;">
                    <i class="fa-solid fa-circle-exclamation" style="font-size: 30px; margin-bottom: 10px;"></i> <br />
                    Este link é inválido ou expirou. Solicite uma nova recuperação de senha.
                </div>

                <a asp-action="ForgotPassword" class="btn-submit" style="text-decoration: none;">
                    Solicitar novo link
                </a>
            }
            else
            {
                <form asp-action="ResetPassword" method="post">
                    <input type="hidden" name="token" value="@ViewBag.Token" />

                    <div class="input-group">
                        <label>Nova senha (mín. 8 caracteres)</label>
                        <div class="input-field">
                            <i class="fa-solid fa-lock"></i>
                            <input type="password" name="Senha" minlength="8" required />
                        </div>
                    </div>

                    <div class="input-group">
                        <label>Confirmar nova senha</label>
                        <div class="input-field">
                            <i class="fa-solid fa-lock"></i>
                            <input type="password" name="ConfirmaSenha" minlength="8" required />
                        </div>
                    </div>

                    <button type="submit" class="btn-submit">
                        Salvar nova senha <i class="fa-solid fa-check"></i>
                    </button>
                </form>
            }
        </div>

        <div class="footer">
            <a asp-action="Index" style="text-decoration: none; color: #6B7280;">
                <i class="fa-solid fa-arrow-left"></i> Voltar para o Login
            </a>
        </div>

    </div>
</body>
</html>