@model CompletaJaApp.Models.Usuario

@{
    ViewData["Title"] = "Editar Perfil";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/usuario.css"
          asp-append-version="true" />

    <style>
        .alerta-erro {
            background-color: #fee2e2;
            color: #b91c1c;
            padding: 12px;
            margin-bottom: 15px;
            border-radius: 8px;
            font-weight: 600;
            text-align: center;
        }
    </style>
}

<main class="content profile-content">
    <div class="profile-container">

        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert-sucesso">
                <i class="fa-solid fa-circle-check"></i>
                @TempData["MensagemSucesso"]
            </div>
        }

        @if (TempData["MensagemErro"] != null)
        {
            <div class="alerta-erro">
                <i class="fa-solid fa-circle-exclamation"></i>
                @TempData["MensagemErro"]
            </div>
        }

        <form action="/Usuario/Salvar"
              method="post"
              enctype="multipart/form-data"
              class="profile-form">

            <div style="
                display: flex;
                flex-direction: column;
                align-items: center;
                width: 100%;">

                <div class="avatar-upload-wrapper"
                     onclick="dispararUpload()">

                    <img src="@(string.IsNullOrEmpty(Model.FotoUrl) ? "/images/default-avatar.png" : Model.FotoUrl)"
                         id="imgPreview"
                         class="avatar-preview"
                         alt="Sua foto" />

                    <div class="camera-badge">
                        <i class="fa-solid fa-camera"></i>
                    </div>
                </div>

                <input type="file"
                       name="NovaFoto"
                       id="inputFotoReal"
                       accept=".jpg,.jpeg,.png,.webp"
                       style="display: none;"
                       onchange="previewImagem(event)" />
            </div>

            <div class="form-group">
                <label>Nome Completo</label>

                <input type="text"
                       value="@Model.Nome"
                       readonly />
            </div>

            <div class="form-group">
                <label>E-mail de Cadastro</label>

                <input type="email"
                       value="@Model.Email"
                       readonly />
            </div>

            <div class="form-group">
                <label>Nova Senha de Acesso</label>

                <input type="password"
                       name="NovaSenha"
                       placeholder="Digite apenas se desejar alterar..."
                       autocomplete="new-password" />
            </div>

            <button type="submit"
                    class="btn-salvar-perfil">

                Salvar Alterações
            </button>
        </form>
    </div>
</main>

@section Scripts {
    <script src="~/js/usuario.js"
            asp-append-version="true">
    </script>
}