@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@using Microsoft.AspNetCore.Http

@{
    var fotoUsuario =
        Context.Session.GetString(
            "FotoUsuario");

    if (string.IsNullOrWhiteSpace(fotoUsuario))
    {
        fotoUsuario = "/images/default-avatar.png";
    }

    // Na tela inicial não há para onde "voltar"
    var rotaAtual = ViewContext.RouteData.Values;
    bool ehInicio =
        string.Equals(rotaAtual["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(rotaAtual["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - CompletaJá
    </title>

    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <style>
            .btn-voltar-layout {
                background: none;
                border: none;
                color: #6B7280;
                font-size: 1.2rem;
                cursor: pointer;
                margin-right: 12px;
                padding: 5px;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: color 0.2s, transform 0.1s;
            }

                .btn-voltar-layout:hover {
                    color: #1D58E6;
                    transform: scale(1.1);
                }
    </style>

    <meta name="csrf-token" content="@(Antiforgery.GetAndStoreTokens(Context).RequestToken)" />

    @RenderSection(
        "Styles",
        required: false)
</head>

<body>
    <div class="app-container">

        <header class="top-header">
            <div class="user-info">

                @if (!ehInicio)
                {
                    <button type="button"
                            onclick="voltarTela()"
                            class="btn-voltar-layout"
                            title="Voltar"
                            aria-label="Voltar">

                        <i class="fa-solid fa-arrow-left"></i>
                    </button>
                }

                <a href="/Usuario/Editar"
                   style="
                    display: flex;
                    align-items: center;
                    text-decoration: none;">

                    <img src="@fotoUsuario"
                         alt="Perfil"
                         class="avatar-top"
                         style="
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    object-fit: cover;
                    cursor: pointer;
                    transition: transform 0.2s;" />
                </a>

                <span class="logo-text">
                    CompletaJá
                </span>
            </div>

            <div class="header-actions">

                <form method="post"
                      action="/Home/Sair"
                      asp-antiforgery="true"
                      onsubmit="return confirm('Tem certeza que deseja sair do sistema?');"
                      style="margin: 0;">

                    <button type="submit"
                            class="btn-sair"
                            style="
                    background: none;
                    border: none;
                    padding: 0;
                    cursor: pointer;
                    font-family: inherit;
                    color: #6B7280;
                    font-size: 13px;
                    font-weight: 600;
                    display: flex;
                    gap: 5px;
                    align-items: center;">

                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        Sair
                    </button>
                </form>
            </div>
        </header>

        @RenderBody()

        <nav class="bottom-nav">
            <a href="/Home"
               class="nav-item">

                <i class="fa-solid fa-house"></i>
                <span>Home</span>
            </a>

            <a href="/Album"
               class="nav-item">

                <i class="fa-solid fa-book-open"></i>
                <span>Álbuns</span>
            </a>

            <a href="/Locais"
               class="nav-item">

                <i class="fa-solid fa-map-location-dot"></i>
                <span>Locais</span>
            </a>

            <a href="/Troca"
               class="nav-item">

                <i class="fa-solid fa-comments"></i>
                <span>Trocas</span>
            </a>
        </nav>
    </div>

    <div vw class="enabled">
        <div vw-access-button
             class="active">
        </div>

        <div vw-plugin-wrapper>
            <div vw-plugin-top-wrapper>
            </div>
        </div>
    </div>

    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>

    <script>
            new window.VLibras.Widget(
                'https://vlibras.gov.br/app');
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)
    <script>
        // Botão "voltar": só volta se a página anterior for do próprio
        // sistema e não for a tela de login; caso contrário vai ao início.
        function voltarTela() {
            var ref = document.referrer || '';
            var mesmoSite = ref.indexOf(location.origin) === 0;
            var veioDoLogin = /\/Account(\/|$|\?)/i.test(ref.substring(location.origin.length));

            if (mesmoSite && !veioDoLogin && history.length > 1) {
                history.back();
            } else {
                location.href = '@Url.Action("Index", "Home")';
            }
        }

        // Foto quebrada: troca pelo avatar padrão (uma única vez por imagem)
        document.addEventListener('error', function (e) {
            var img = e.target;
            if (img && img.tagName === 'IMG' && !img.dataset.fallback &&
                /avatar|profile-img/.test(img.className)) {
                img.dataset.fallback = '1';
                img.src = '/images/default-avatar.png';
            }
        }, true);
    </script>
</body>
</html>